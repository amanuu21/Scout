# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://scout:scout_dev@localhost:5432/scout
DATABASE_URL_SYNC=postgresql://scout:scout_dev@localhost:5432/scout
POSTGRES_USER=scout
POSTGRES_PASSWORD=scout_dev
POSTGRES_DB=scout

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── Telegram (Optional) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Application ────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-key
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ─── Worker ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
